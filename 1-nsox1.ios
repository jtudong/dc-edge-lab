!Command: show running-config
!Running configuration last done at: Mon Aug 10 15:50:26 2026
!Time: Mon Aug 10 16:01:34 2026

version 10.5(2) Bios:version
hostname nsox1
vdc nsox1 id 1
  limit-resource vlan minimum 16 maximum 4094
  limit-resource vrf minimum 2 maximum 4096
  limit-resource port-channel minimum 0 maximum 511
  limit-resource m4route-mem minimum 58 maximum 58
  limit-resource m6route-mem minimum 8 maximum 8

cfs eth distribute
feature ospf
feature interface-vlan
feature hsrp
feature lacp
feature vpc
clock timezone MST -7 0

no password strength-check
username admin password 5 $5$PMHDED$XhWlmjb6pJlNovFKVemxkSUjwCkjmXoVfnFQ071jky3  role network-admin
username lab password 5 $5$BOGJDO$CipRM3rNw9kK0evNcp4NUVSF4Ye2UWRfNFXFdENupa9  role network-admin
username lab passphrase  lifetime 99999 warntime 14 gracetime 3
no password secure-mode
ip domain-lookup
copp profile strict
snmp-server user lab network-admin auth md5 042AAF5C3E421DF10F5C79D24B74F3BF0C5E priv aes-128 055ECE315A9BA401B3EAD65BCAFA670FC497 localizedV2key
snmp-server user admin network-admin auth md5 164B1562DEF5ABBA8C20B5AB3916CA5A8C9B priv aes-128 330D730AC916061861C4062CA499509A4A50 localizedV2key
rmon event 1 log trap public description FATAL(1) owner PMON@FATAL
rmon event 2 log trap public description CRITICAL(2) owner PMON@CRITICAL
rmon event 3 log trap public description ERROR(3) owner PMON@ERROR
rmon event 4 log trap public description WARNING(4) owner PMON@WARNING
rmon event 5 log trap public description INFORMATION(5) owner PMON@INFO

ip route 0.0.0.0/0 172.16.192.57 171
ip route 0.0.0.0/0 172.16.192.65 171
vlan 1,252,801
vlan 252
  name Server-VLAN
vlan 801
  name EPBR

vrf context management
vrf context vpc-keepalive
vpc domain 201
  peer-switch
  role priority 1000
  system-priority 1
  peer-keepalive destination 172.16.192.102 source 172.16.192.101 vrf vpc-keepalive
  delay restore 150
  peer-gateway
  layer3 peer-router
  ip arp synchronize

interface Vlan1
  no ip redirects
  no ipv6 redirects

interface Vlan252
  description Phoenix Servers
  no shutdown
  mtu 9216
  no ip redirects
  ip address 172.16.253.2/22
  no ipv6 redirects
  ip ospf passive-interface
  ip router ospf 10 area 0.0.0.0
  hsrp version 2
  hsrp delay reload 150
  hsrp 252
    authentication md5 key-string 3m3rg3ncy!
    preempt
    priority 105
    ip 172.16.252.1

interface Vlan801
  no shutdown
  no ip redirects
  ip address 10.252.250.18/28
  no ipv6 redirects
  ip router ospf 10 area 0.0.0.0
  hsrp version 2
  hsrp delay reload 150
  hsrp 801
    authentication md5 key-string 3m3rg3ncy!
    preempt
    priority 105 forwarding-threshold lower 1 upper 105
    ip 10.252.250.17

interface port-channel1
  description *** vPC Link to nsox2 ***
  switchport mode trunk
  spanning-tree port type network
  vpc peer-link

interface port-channel100
  description ** vPC link to sw1 ***
  switchport mode trunk
  vpc 100

interface port-channel101
  switchport mode trunk
  switchport trunk allowed vlan 801
  vpc 101

interface port-channel102
  switchport mode trunk
  switchport trunk allowed vlan 801
  vpc 102

interface port-channel801
  description ** vPC link to FW1 ***
  switchport mode trunk
  switchport trunk allowed vlan 801
  vpc 801

interface Ethernet1/1
  description *** peer keepalive to nsox2 ***
  no switchport
  vrf member vpc-keepalive
