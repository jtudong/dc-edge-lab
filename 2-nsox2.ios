ip route 0.0.0.0/0 172.16.192.57 171
ip route 0.0.0.0/0 172.16.192.65 171
vlan 1,252,801
vlan 252
  name Server-VLAN
vlan 801
  name EPBR

vrf context management
vrf context vpc-keepalive
vpc domain 201
  peer-switch
  role priority 2000
  system-priority 1
  peer-keepalive destination 172.16.192.101 source 172.16.192.102 vrf vpc-keepalive
  delay restore 150
  peer-gateway
  layer3 peer-router
  ip arp synchronize

interface Vlan1
  no ip redirects
  no ipv6 redirects

interface Vlan252
  description Phoenix Servers
  no shutdown
  mtu 9216
  no ip redirects
  ip address 172.16.253.3/22
  no ipv6 redirects
  ip ospf passive-interface
  ip router ospf 10 area 0.0.0.0
  hsrp version 2
  hsrp delay reload 150
  hsrp 252
    authentication md5 key-string 3m3rg3ncy!
    preempt
    ip 172.16.252.1

interface Vlan801
  no shutdown
  no ip redirects
  ip address 10.252.250.19/28
  no ipv6 redirects

interface port-channel1
  description *** vPC link to nsox1 ***
  switchport mode trunk
  spanning-tree port type network
  vpc peer-link

interface port-channel100
  description ** vPC link to sw1 ***
  switchport mode trunk
  vpc 100

interface port-channel801
